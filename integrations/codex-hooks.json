{
  "description": "Drive Buffering Cat LEDs from ChatGPT/Codex lifecycle events without model tool calls.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zhixuan/code/buffering_cat/integrations/codex-led-hook.sh idle",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zhixuan/code/buffering_cat/integrations/codex-led-hook.sh thinking",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zhixuan/code/buffering_cat/integrations/codex-led-hook.sh requires-input",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zhixuan/code/buffering_cat/integrations/codex-led-hook.sh post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zhixuan/code/buffering_cat/integrations/codex-led-hook.sh complete",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zhixuan/code/buffering_cat/integrations/codex-led-hook.sh off",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
